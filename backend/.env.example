# ─── Server ─────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
APP_BASE_URL=http://localhost:3000

# ─── Database ───────────────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/medconsults

# ─── JWT & Auth ─────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
JWT_REFRESH_SECRET=fedcba9876543210fedcba9876543210fedcba9876543210fedcba9876543210
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── Encryption ─────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NOTE_ENCRYPTION_KEY_V1=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# ─── Business Rules ─────────────────────────────────────────────────────
CANCEL_WINDOW_HOURS=4
DEFAULT_BOOKING_LIMIT_PER_DOCTOR=3

# ─── CORS & Client ──────────────────────────────────────────────────────
CLIENT_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ─── Email (Nodemailer / SMTP) ──────────────────────────────────────────
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=test_user
SMTP_PASS=test_pass
EMAIL_FROM=Medconsults <noreply@medconsults.com>

# ─── Monitoring (Optional) ──────────────────────────────────────────────
SENTRY_DSN=

# ─── Postman Integration (Optional) ────────────────────────────────────
# POSTMAN_API_KEY=PMAK-xxxx
# POSTMAN_WORKSPACE_ID=xxxx
