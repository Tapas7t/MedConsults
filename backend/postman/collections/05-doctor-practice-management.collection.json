  "item": [
    {
      "name": "GET Doctor Profile & Settings",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ],
        "url": "{{baseUrl}}/api/v1/doctor/profile"
      }
    },
    {
      "name": "PATCH Update Doctor & Clinic Profile",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Dr. Ananya Roy\",\n  \"type\": \"doctor\",\n  \"specialty\": \"General Physician\",\n  \"qualifications\": \"MBBS, MD\",\n  \"licenceNo\": \"MED-KA-2024-9988\",\n  \"experienceYears\": 12,\n  \"languages\": [\n    \"English\",\n    \"Hindi\",\n    \"Kannada\"\n  ],\n  \"bio\": \"Dedicated physician specializing in preventative medicine and family wellness.\",\n  \"fee\": 600,\n  \"slotMinutes\": 30,\n  \"leadTimeMin\": 60,\n  \"horizonDays\": 30,\n  \"cancelWindowHours\": 4,\n  \"autoConfirm\": true,\n  \"listedInDirectory\": true,\n  \"clinic\": {\n    \"name\": \"Roy Wellness Clinic\",\n    \"address\": \"Suite 401, Health Hub, 100 Feet Rd, Indiranagar\",\n    \"area\": \"Indiranagar\",\n    \"city\": \"Bangalore\",\n    \"postalCode\": \"560038\",\n    \"phone\": \"+918023456789\",\n    \"timezone\": \"Asia/Kolkata\",\n    \"notes\": \"Free parking behind the building; elevator accessible.\"\n  }\n}"
        },
        "url": "{{baseUrl}}/api/v1/doctor/profile"
      }
    },
    {
