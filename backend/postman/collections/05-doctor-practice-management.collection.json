        "body": {
          "mode": "raw",
          "raw": "{\n  \"weekly\": [\n    {\n      \"day\": \"monday\",\n      \"ranges\": [\n        {\n          \"start\": \"09:00\",\n          \"end\": \"13:00\"\n        },\n        {\n          \"start\": \"14:00\",\n          \"end\": \"18:00\"\n        }\n      ],\n      \"breaks\": [\n        {\n          \"start\": \"13:00\",\n          \"end\": \"14:00\"\n        }\n      ]\n    },\n    {\n      \"day\": \"tuesday\",\n      \"ranges\": [\n        {\n          \"start\": \"09:00\",\n          \"end\": \"13:00\"\n        },\n        {\n          \"start\": \"14:00\",\n          \"end\": \"18:00\"\n        }\n      ],\n      \"breaks\": [\n        {\n          \"start\": \"13:00\",\n          \"end\": \"14:00\"\n        }\n      ]\n    },\n    {\n      \"day\": \"wednesday\",\n      \"ranges\": [\n        {\n          \"start\": \"09:00\",\n          \"end\": \"13:00\"\n        },\n        {\n          \"start\": \"14:00\",\n          \"end\": \"18:00\"\n        }\n      ],\n      \"breaks\": [\n        {\n          \"start\": \"13:00\",\n          \"end\": \"14:00\"\n        }\n      ]\n    },\n    {\n      \"day\": \"thursday\",\n      \"ranges\": [\n        {\n          \"start\": \"09:00\",\n          \"end\": \"13:00\"\n        },\n        {\n          \"start\": \"14:00\",\n          \"end\": \"18:00\"\n        }\n      ],\n      \"breaks\": [\n        {\n          \"start\": \"13:00\",\n          \"end\": \"14:00\"\n        }\n      ]\n    },\n    {\n      \"day\": \"friday\",\n      \"ranges\": [\n        {\n          \"start\": \"09:00\",\n          \"end\": \"13:00\"\n        },\n        {\n          \"start\": \"14:00\",\n          \"end\": \"18:00\"\n        }\n      ],\n      \"breaks\": [\n        {\n          \"start\": \"13:00\",\n          \"end\": \"14:00\"\n        }\n      ]\n    },\n    {\n      \"day\": \"saturday\",\n      \"ranges\": [\n        {\n          \"start\": \"10:00\",\n          \"end\": \"14:00\"\n        }\n      ],\n      \"breaks\": []\n    }\n  ],\n  \"exceptions\": [\n    {\n      \"date\": \"2026-12-25\",\n      \"isClosed\": true\n    }\n  ]\n}"
        },
        "url": "{{baseUrl}}/api/v1/doctor/availability"
