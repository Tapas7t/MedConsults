{
  "info": {
    "name": "03. Users & Family Dependents",
    "description": "Medconsults API - 03. Users & Family Dependents endpoints with sample request bodies.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "GET My Profile",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ],
        "url": "{{baseUrl}}/api/v1/users/me"
      }
    },
    {
      "name": "PATCH Update Profile",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"phone\": \"+919876543210\"\n}"
        },
        "url": "{{baseUrl}}/api/v1/users/me"
      }
    },
    {
      "name": "GET Export My Data (Privacy / GDPR)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ],
        "url": "{{baseUrl}}/api/v1/users/me/export"
      }
    },
    {
      "name": "GET List Dependents (Family Members)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ],
        "url": "{{baseUrl}}/api/v1/users/me/dependents"
      }
    },
    {
      "name": "POST Create Dependent",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Aarav Sharma\",\n  \"dob\": \"2018-05-14\",\n  \"relation\": \"Child\"\n}"
        },
        "url": "{{baseUrl}}/api/v1/users/me/dependents"
      }
    },
    {
      "name": "PATCH Update Dependent",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Aarav Sharma (Updated)\",\n  \"relation\": \"Son\"\n}"
        },
        "url": "{{baseUrl}}/api/v1/users/me/dependents/{{dependentId}}"
      }
    },
    {
      "name": "DELETE Dependent",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ],
        "url": "{{baseUrl}}/api/v1/users/me/dependents/{{dependentId}}"
      }
    }
  ]
}