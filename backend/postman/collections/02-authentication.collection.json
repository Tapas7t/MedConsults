{
  "info": {
    "name": "02. Authentication",
    "description": "Medconsults API - 02. Authentication endpoints with sample request bodies.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "POST Register (Patient)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 200 || pm.response.code === 201) {",
              "  const res = pm.response.json();",
              "  if (res.data && res.data.accessToken) {",
              "    pm.environment.set(\"accessToken\", res.data.accessToken);",
              "    console.log(\"Auto-saved accessToken to environment\");",
              "  }",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"patient_new@example.com\",\n  \"password\": \"SecurePass123!\",\n  \"role\": \"patient\"\n}"
        },
        "url": "{{baseUrl}}/api/v1/auth/register"
      }
    },
