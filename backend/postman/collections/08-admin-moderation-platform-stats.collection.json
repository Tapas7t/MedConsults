{
  "info": {
    "name": "08. Admin Moderation & Platform Stats",
    "description": "Medconsults API - 08. Admin Moderation & Platform Stats endpoints with sample request bodies.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "GET Doctor Approval Queue",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/admin/doctors?status=pending_approval",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "admin",
            "doctors"
          ],
          "query": [
            {
              "key": "status",
              "value": "pending_approval"
            }
          ]
        }
      }
    },
    {
      "name": "PATCH Approve / Reject Doctor",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"approved\"\n}"
        },
        "url": "{{baseUrl}}/api/v1/admin/doctors/{{doctorId}}/status"
      }
    },
    {
      "name": "GET Platform Users List (Search & Filter)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/admin/users?role=patient",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "admin",
            "users"
          ],
          "query": [
            {
              "key": "role",
              "value": "patient"
            }
          ]
        }
      }
    },
    {
      "name": "PATCH Block / Unblock User",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"isBlocked\": true\n}"
        },
        "url": "{{baseUrl}}/api/v1/admin/users/{{targetUserId}}/block"
      }
    },
    {
      "name": "GET Platform Counters & Metrics",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ],
        "url": "{{baseUrl}}/api/v1/admin/stats"
      }
    }
  ]
}