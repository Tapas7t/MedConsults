{
  "info": {
    "name": "06. Appointments Lifecycle & Notes",
    "description": "Medconsults API - 06. Appointments Lifecycle & Notes endpoints with sample request bodies.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "POST Book Slot (Transactional with Overlap Guard)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"doctorId\": \"{{doctorId}}\",\n  \"startAt\": \"2026-11-20T04:30:00.000Z\",\n  \"patientType\": \"self\",\n  \"reason\": \"Routine health screening and blood pressure checkup\"\n}"
        },
        "url": "{{baseUrl}}/api/v1/appointments"
      }
    },
    {
      "name": "GET My Appointments (Upcoming & Past)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ],
        "url": "{{baseUrl}}/api/v1/appointments"
      }
    },
    {
      "name": "GET Appointment Detail by ID",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ],
        "url": "{{baseUrl}}/api/v1/appointments/{{appointmentId}}"
      }
    },
    {
      "name": "PATCH Update Status (arrived / completed / cancelled / no_show)",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"arrived\",\n  \"reason\": \"Patient checked in at reception\"\n}"
        },
        "url": "{{baseUrl}}/api/v1/appointments/{{appointmentId}}/status"
      }
    },
    {
      "name": "POST Reschedule Appointment (Atomic)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"newStartAt\": \"2026-11-21T05:00:00.000Z\",\n  \"reason\": \"Patient requested next day slot\"\n}"
        },
        "url": "{{baseUrl}}/api/v1/appointments/{{appointmentId}}/reschedule"
      }
    },
    {
      "name": "PUT Consultation Notes (AES-256 Encrypted at Rest)",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"notes\": \"BP: 120/80 mmHg. Normal heart sounds. Advised lifestyle modifications, low sodium diet, and repeat follow-up in 30 days.\"\n}"
        },
        "url": "{{baseUrl}}/api/v1/appointments/{{appointmentId}}/notes"
      }
    },
    {
      "name": "GET iCalendar File (.ics Download)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ],
        "url": "{{baseUrl}}/api/v1/appointments/{{appointmentId}}/calendar.ics"
      }
    }
  ]
}